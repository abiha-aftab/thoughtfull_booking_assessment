# Local MongoDB. `docker compose up` publishes this port.
# Inside Compose, the API uses mongodb://mongo:27017/thoughtfull-booking instead.
MONGODB_URI=mongodb://127.0.0.1:27017/thoughtfull-booking

# HTTP port for the API.
API_PORT=4000

# Browser origin allowed to call the API during local development.
WEB_ORIGIN=http://localhost:5173

NODE_ENV=development
